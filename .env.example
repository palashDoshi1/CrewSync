# Copy to .env. Obtain all three values from Luminal's dashboard or sponsor.
# Non-secret settings confirmed in the Luminal dashboard.
LUMINAL_API_KEY=
LUMINAL_BASE_URL=https://flash.luminal.cloud/v1
LUMINAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Optional: use Atlas instead of the local event library. Do not share this URI.
MONGODB_URI=
MONGODB_DATABASE=crewsync
